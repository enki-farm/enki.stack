#!/command/with-contenv sh
set -eu

chmod go-w /opt/data
install -d -o root -g root -m 0700 /opt/data/ssh
install -d -o hermes -g hermes -m 0700 /opt/data/home

account_password="$(head -c 48 /dev/urandom | base64 | tr -d '\n')"
[ -n "$account_password" ]
printf 'hermes:%s\n' "$account_password" | chpasswd
unset account_password

if [ ! -s /opt/data/ssh/ssh_host_ed25519_key ]; then
    ssh-keygen -q -t ed25519 -N '' -f /opt/data/ssh/ssh_host_ed25519_key
fi

chmod 0600 /opt/data/ssh/ssh_host_ed25519_key
chmod 0644 /opt/data/ssh/ssh_host_ed25519_key.pub
sshd -t -f /etc/ssh/sshd_config
exec /usr/sbin/sshd -D -e -f /etc/ssh/sshd_config