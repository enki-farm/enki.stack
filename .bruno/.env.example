# Copy to .bruno/.env (gitignored). Read the values from the cluster:
#   kubectl -n crawl4ai get secret crawl4ai-credentials -o jsonpath='{.data.CRAWL4AI_API_TOKEN}' | base64 -d
#   kubectl -n crawl4ai get secret crawl4ai-credentials -o jsonpath='{.data.FIRECRAWL_SHIM_API_KEY}' | base64 -d
CRAWL4AI_API_TOKEN=
FIRECRAWL_SHIM_API_KEY=
