# Copy to k8s/dex/auth.env (ignored by git). Not for secrets.
# Public HTTPS origins, each on its own host.
DEX_ISSUER=https://auth.example.com
GRAFANA_URL=https://grafana.example.com
HUB_URL=https://hub.zer0.garden
HUB_GROUP=enki-farm:core

GRAFANA_VIEWER_GROUP=your-org:ai-users
# Leave empty to grant nobody Grafana Admin.
GRAFANA_ADMIN_GROUP=your-org:observability-admins

# Optional; defaults shown.
GATEWAY_NAME=envoy-ai-gateway-basic
GATEWAY_NAMESPACE=envoy-ai-gateway-system
