{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "templating": {
    "list": [
      {
        "name": "model_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_llm_ttft_milliseconds_p95, model_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "model_config",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_llm_ttft_milliseconds_p95{model_id=~\"$model_id\"}, model_config)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "run_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_llm_ttft_milliseconds_p95{model_id=~\"$model_id\", model_config=~\"$model_config\"}, run_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_ttft_milliseconds_p50{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p50 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_ttft_milliseconds_p95{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p95 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_ttft_milliseconds_p99{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p99 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "C"
        }
      ],
      "title": "Time to first token",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_time_per_output_token_milliseconds_p50{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p50 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_time_per_output_token_milliseconds_p95{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p95 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "B"
        }
      ],
      "title": "Inter-token latency (time per output token)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model_id, model_config, run_id) (rate(k6_llm_completion_tokens_total{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "completion {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model_id, model_config, run_id) (rate(k6_llm_prompt_tokens_total{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "prompt {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "B"
        }
      ],
      "title": "Token throughput (tokens/s, total)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model_id, model_config, run_id) (rate(k6_llm_completion_tokens_total{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}[$__rate_interval])) / sum by (model_id, model_config, run_id) (k6_vus{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"})",
          "legendFormat": "{{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        }
      ],
      "title": "Token throughput per active VU (tokens/s/VU)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model_id, model_config, run_id) (rate(k6_sse_event_total{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "SSE events/s {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model_id, model_config, run_id) (rate(k6_iterations_total{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "requests/s {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "B"
        }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_request_errors_rate{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "{{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        }
      ],
      "title": "Request error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_e2e_latency_milliseconds_p50{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p50 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_llm_e2e_latency_milliseconds_p95{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "p95 {{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "B"
        }
      ],
      "title": "End-to-end request latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_vus{model_id=~\"$model_id\", model_config=~\"$model_config\", run_id=~\"$run_id\"}",
          "legendFormat": "{{model_id}} / {{model_config}} / {{run_id}}",
          "refId": "A"
        }
      ],
      "title": "Active virtual users",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["enki-infer", "k6", "benchmark"],
