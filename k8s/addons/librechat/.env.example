# Copy to .env and fill in. Empty credential values are generated by install-librechat.sh
# on first install; keep them stable afterwards or sessions/encrypted data break.
ENKI_GATEWAY_API_KEY=sk-local-vllm
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=
# Leave empty to read FIRECRAWL_SHIM_API_KEY from the crawl4ai/crawl4ai-credentials Secret.
FIRECRAWL_API_KEY=
# CRAWL4AI_API_TOKEN is copied from that same Secret by install-librechat.sh for the MCP connection.
