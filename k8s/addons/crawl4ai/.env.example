# Copy to .env and fill in. Empty values are reused from the existing Secret or generated once.
CRAWL4AI_API_TOKEN=
# LibreChat reads this key from the crawl4ai-credentials Secret when installing its addon.
FIRECRAWL_SHIM_API_KEY=
# Used by Crawl4AI's LLM features (/md f=llm, /llm) against https://ai.zer0.garden/v1.
ENKI_GATEWAY_API_KEY=sk-local-vllm
